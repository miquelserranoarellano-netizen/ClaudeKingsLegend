# Plantilla de configuración. Cópiala como `.env` (producción) o `.env.local` (desarrollo) y rellénala.
# NUNCA subas el `.env` real al repositorio: contiene secretos.

# --- Imprescindibles en producción -------------------------------------------------------------------

# Dominio (sin https) y URL pública (con https). La URL se usa en enlaces, correos y metadatos.
DOMAIN=kingslegend.es
NEXT_PUBLIC_SITE_URL=https://kingslegend.es

# Secreto con el que se firman las sesiones: mínimo 32 caracteres aleatorios.
# Genera uno con:  openssl rand -base64 48
BETTER_AUTH_SECRET=

# Contraseña de PostgreSQL (solo letras y números, para no tener que escaparla en la URL).
# Genera una con:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Si NO usas el Postgres de docker-compose (por ejemplo, uno gestionado), define la URL completa:
# DATABASE_URL=postgres://usuario:contraseña@servidor:5432/base?sslmode=require

# --- Correo (opcional) -------------------------------------------------------------------------------
# Sin SMTP la aplicación funciona, pero no hay verificación de correo, ni recuperación de contraseña,
# ni avisos por correo (las pantallas lo indican). Sirve el correo de Hostinger u otro proveedor SMTP.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Kings Legend <no-responder@kingslegend.es>"

# --- Opcionales --------------------------------------------------------------------------------------
# Zona horaria en la que se muestran las fechas (se guardan en UTC).
NEXT_PUBLIC_TIME_ZONE=Europe/Madrid
# Conexiones simultáneas a la base de datos.
# DATABASE_POOL_MAX=10
# Impedir la indexación en buscadores aunque sea producción (por ejemplo, en un entorno de pruebas).
# ALLOW_INDEXING=0
# Activar el límite de intentos de acceso también en desarrollo.
# AUTH_RATE_LIMIT=1
# Solo desarrollo: carpeta de la base local (PGlite). Por defecto, .data/
# DATA_DIR=
