# Plantilla de configuración. Cópiala como `.env` (producción) o `.env.local` (desarrollo) y rellénala.
# NUNCA subas el `.env` real al repositorio: contiene secretos.

# --- Imprescindibles en producción -------------------------------------------------------------------

# Dominio (sin https) y URL pública (con https). La URL se usa en enlaces, correos y metadatos.
DOMAIN=kingslegend.es
NEXT_PUBLIC_SITE_URL=https://kingslegend.es

# Secreto con el que se firman las sesiones: mínimo 32 caracteres aleatorios.
# Genera uno con:  openssl rand -base64 48
BETTER_AUTH_SECRET=

# Contraseña de PostgreSQL (solo letras y números, para no tener que escaparla en la URL).
# Genera una con:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Si NO usas el Postgres de docker-compose (por ejemplo, uno gestionado), define la URL completa:
# DATABASE_URL=postgres://usuario:contraseña@servidor:5432/base?sslmode=require

# --- Cloudflare Workers ------------------------------------------------------------------------------
# En Cloudflare estas variables NO van en un archivo: se definen en el panel del Worker
# (ver docs/DESPLIEGUE-CLOUDFLARE.md). NEXT_PUBLIC_SITE_URL va en las variables de COMPILACIÓN;
# BETTER_AUTH_SECRET, SMTP_PASSWORD, RESEND_API_KEY y GOOGLE_CLIENT_SECRET, como secretos. La base de datos llega por Hyperdrive (wrangler.jsonc),
# no por DATABASE_URL. Para probar el Worker en local (`npm run preview:cf`) usa un archivo `.dev.vars`.

# --- Correo (opcional) -------------------------------------------------------------------------------
# Sin correo la aplicación funciona, pero no hay verificación de correo, ni recuperación de contraseña,
# ni avisos por correo (las pantallas lo indican). Hace falta MAIL_FROM y uno de estos dos proveedores:
#  - Resend (API HTTP; necesita un dominio propio verificado): RESEND_API_KEY.
#  - SMTP: una cuenta de Gmail con contraseña de aplicación (smtp.gmail.com, 465; sirve también en
#    Cloudflare y no necesita dominio), el correo de Hostinger u otro proveedor.
# RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Kings Legend <no-responder@kingslegend.es>"

# --- Entrar con Google (opcional) --------------------------------------------------------------------
# Cliente OAuth «Aplicación web» de console.cloud.google.com, con la URI de redirección
# <NEXT_PUBLIC_SITE_URL>/api/auth/callback/google. Sin estas dos variables no aparece el botón.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Opcionales --------------------------------------------------------------------------------------
# Zona horaria en la que se muestran las fechas (se guardan en UTC).
NEXT_PUBLIC_TIME_ZONE=Europe/Madrid
# Conexiones simultáneas a la base de datos.
# DATABASE_POOL_MAX=10
# Impedir la indexación en buscadores aunque sea producción (por ejemplo, en un entorno de pruebas).
# ALLOW_INDEXING=0
# Activar el límite de intentos de acceso también en desarrollo.
# AUTH_RATE_LIMIT=1
# Solo desarrollo: carpeta de la base local (PGlite). Por defecto, .data/
# DATA_DIR=
